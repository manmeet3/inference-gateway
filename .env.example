# Copy to .env for local development outside Docker.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
LOG_LEVEL=INFO
# Optional — leave blank if you don't have a Tempo/OTLP collector running.
OTLP_ENDPOINT=
SERVICE_NAME=inference-gateway
